# Copy to ".env" for local use. Never commit the real .env file.
# On Vercel, enter the same names under Project Settings -> Environment Variables.

# "development" (default) or "production". Set to "production" on Vercel.
APP_ENV=development

# REQUIRED. Your PostgreSQL connection string (Neon, Supabase, Vercel Postgres, local...).
# Use the "pooled" connection string if your provider offers one (best for Vercel).
DATABASE_URL=postgresql://user:password@localhost:5432/service_requests

# REQUIRED when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development, if this is empty, a random key is made each time the server starts.
SECRET_KEY=change-me-generate-a-long-random-value

# First administrator, created by "flask --app portal init-db" if no administrator exists yet.
# Set a strong password, sign in, then create department officers from the Users page.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-now
# ADMIN_NAME=System Administrator

# Optional overrides
# REF_PREFIX=PSR
# COUNTY_NAME=County Government
# APP_NAME=Public Service Request Portal
# PORT=5000
